{
  "name": "treechats",
  "version": "0.1.0",
  "private": true,
  "description": "Branch, merge and rearrange conversations with Claude, like a git history for chats. Runs locally with your API key or Claude Code.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prestart": "node scripts/ensure-deps.mjs",
    "start": "vite build && tsx --disable-warning=ExperimentalWarning server/start.ts --open",
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch --disable-warning=ExperimentalWarning server/start.ts --dev\" \"vite\"",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test --import tsx \"tests/*.test.ts\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --import tsx \"tests/e2e/*.test.ts\"",
    "serve": "tsx --disable-warning=ExperimentalWarning server/start.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.12",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "mermaid": "^11.17.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "playwright": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
