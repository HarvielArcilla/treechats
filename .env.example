# Copy this file to .env. .env is never committed.

# Where replies come from:
#   auto         your API key if ANTHROPIC_API_KEY is set, otherwise Claude Code (default)
#   api          always your API key, billed to your Anthropic Console account
#   claude-code  your installed Claude Code CLI, using whatever it is signed in with,
#                including a Claude Pro or Max subscription. Sign in once with `claude`.
TREECHATS_PROVIDER=auto

# Your API key, for the api provider. Get one at https://platform.claude.com/settings/keys
# Or leave this empty and save it to the system keychain in Settings › Privacy & security, which is safer.
ANTHROPIC_API_KEY=

# For the claude-code provider: the command to run, if `claude` isn't on your PATH.
# TREECHATS_CLAUDE_PATH=claude

# Which model each tier in the app uses. Change these any time; restart to apply.
TREECHATS_MODEL_QUICK=claude-haiku-4-5-20251001
TREECHATS_MODEL_DEFAULT=claude-sonnet-5-5
TREECHATS_MODEL_COMPLEX=claude-opus-5-5

# What each tier's model costs, for the cost shown on replies: input, output, cache write, cache read, in US dollars
# per million tokens. Known models are priced already; set these only for others.
# TREECHATS_PRICE_QUICK=1,5,1.25,0.1

# Longest reply Claude may write, in tokens.
TREECHATS_MAX_TOKENS=16000

# Port for http://localhost:<port>. Treechats only listens on this computer.
TREECHATS_PORT=5178

# Where Treechats keeps its data. By default, your account's app data folder:
# ~/Library/Application Support/Treechats (Mac), %APPDATA%\Treechats (Windows), ~/.local/share/treechats (Linux).
# TREECHATS_DATA_DIR=

# The token that signs browsers and coding tools in. By default one is made once and kept in the data folder.
# TREECHATS_TOKEN=

# How many model requests one agent run may spend through MCP (spawn, ask, fork, regenerate, replay, judge,
# combine, distill).
# TREECHATS_AGENT_MAX_REQUESTS=60
